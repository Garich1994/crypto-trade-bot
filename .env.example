# Скопируй этот файл в .env и подставь значения.
# Файл .env в git не попадает (см. .gitignore). Секретов в репозитории нет.

# Токен бота от @BotFather
BOT_TOKEN=

# Домен для HTTPS (Caddy), например: pilot.example.com
# Нужен для прод-деплоя; для локального запуска можно оставить пустым.
DOMAIN=

# --- Брокер (исполнение ордеров) ---
# Режим: paper (по умолчанию) | testnet | live. live включается ТОЛЬКО здесь.
BROKER_MODE=paper
# Тестовые ключи Binance Spot Testnet (testnet.binance.vision). Для live — свои.
# Ключи читаются только отсюда; в коде/логах/чате их нет.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Базовый URL биржи для live (US: Binance.US или другая). По умолчанию глобальная.
BROKER_BASE_URL=
# Дневной лимит убытка для live в USDT (0 = выключено).
BROKER_MAX_DAILY_LOSS_USDT=0
# Снять killswitch после ручной проверки (1 = снять при старте, затем убрать).
BROKER_KILLSWITCH_RESET=
